# Optional: share course and prof ratings through Supabase (see README).
# Leave these unset to keep ratings in each visitor's browser only.
# Both values are public (they ship in the built JS); the anon key is meant for that.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: Supabase for shared course/prof ratings and for accounts (sign-in
# with an emailed code, synced across devices). See README and
# supabase/schema.sql. Leave these unset to keep everything in each visitor's
# browser only; the app works fully without them.
# Both values are public (they ship in the built JS); the anon key is meant for that.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: also offer "Continue with Google" (configure the Google provider in
# Supabase first, with this site's URL in the redirect allow-list).
# VITE_AUTH_GOOGLE=1

# Local development against `npx supabase start` (prints these; they're the
# CLI's fixed demo values, not secrets):
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_ANON_KEY=<ANON_KEY from `npx supabase status`>
